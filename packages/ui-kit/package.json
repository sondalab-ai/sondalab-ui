{
  "name": "@sondalab/ui-kit",
  "version": "0.7.2",
  "description": "Sondalab design tokens as CSS custom properties + the agentic core: component catalog, compliance audit (sl-audit), and author/migrate/adopt workflows.",
  "license": "MIT",
  "author": "marcellobarile",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "sl-audit": "./agent/sl-audit.mjs"
  },
  "exports": {
    "./tokens.css": "./tokens.css",
    "./components.css": "./components.css",
    "./themes/light.css": "./themes/light.css",
    "./themes/dark.css": "./themes/dark.css",
    "./themes/high-contrast.css": "./themes/high-contrast.css",
    "./assets/wordmark.svg": "./assets/sondalab-wordmark.svg",
    "./assets/lockup.svg": "./assets/sondalab-lockup.svg",
    "./assets/favicon.svg": "./assets/favicon.svg",
    "./assets/app-icon.svg": "./assets/app-icon.svg",
    "./assets/avatar-ink.svg": "./assets/sondalab-avatar-ink.svg",
    "./assets/avatar-ink.png": "./assets/sondalab-avatar-ink.png",
    "./assets/avatar-paper.svg": "./assets/sondalab-avatar-paper.svg",
    "./assets/avatar-paper.png": "./assets/sondalab-avatar-paper.png",
    "./agent/sl-audit.mjs": "./agent/sl-audit.mjs",
    "./agent/catalog.json": "./agent/catalog.json",
    "./agent/accent-registry.json": "./agent/accent-registry.json",
    "./agent/substrate-matrix.json": "./agent/substrate-matrix.json",
    "./agent/*": "./agent/*"
  },
  "files": [
    "tokens.css",
    "components.css",
    "themes/light.css",
    "themes/dark.css",
    "themes/high-contrast.css",
    "assets/sondalab-wordmark.svg",
    "assets/sondalab-lockup.svg",
    "assets/favicon.svg",
    "assets/app-icon.svg",
    "assets/sondalab-avatar-ink.svg",
    "assets/sondalab-avatar-ink.png",
    "assets/sondalab-avatar-paper.svg",
    "assets/sondalab-avatar-paper.png",
    "assets/README.md",
    "README.md",
    "agent/"
  ]
}
