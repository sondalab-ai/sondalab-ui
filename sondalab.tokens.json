{
  "$schema-note": "Canonical Sondalab design tokens. Edit here only; run pnpm gen:tokens.",
  "shared": {
    "font": {
      "display": "\"Fraunces\", Georgia, serif",
      "sans": "\"Instrument Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mono": "\"Martian Mono\", ui-monospace, \"SF Mono\", Menlo, monospace"
    },
    "space": { "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.5rem", "6": "2rem", "8": "3rem" },
    "radius": { "sm": "6px", "md": "10px", "lg": "16px", "pill": "9999px" },
    "text": { "xs": "0.75rem", "sm": "0.875rem", "md": "1rem", "lg": "1.125rem", "xl": "1.5rem", "2xl": "2rem", "3xl": "2.75rem", "display": "clamp(3.5rem, 2rem + 5vw, 6rem)" },
    "line": { "tight": "1.2", "normal": "1.5", "relaxed": "1.6", "loose": "1.7" },
    "z": { "base": "1", "overlay": "50", "modal": "100", "toast": "200" },
    "$motion-spring-note": "--sl-motion-spring: a damped spring (stiffness 170, damping 18) sampled into a CSS linear() easing — one ~5% overshoot, then settles. Time-normalised, so it plays at whatever duration token the transition uses. Only for transforms: on a colour the overshoot has no meaning. Re-scope R2 (card spring-tokens), 2026-09-25.",
    "motion": { "fast": "120ms", "mid": "220ms", "slow": "360ms", "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)", "spring": "linear(0, 0.024, 0.087, 0.174, 0.275, 0.382, 0.488, 0.588, 0.68, 0.761, 0.831, 0.89, 0.937, 0.975, 1.003, 1.023, 1.037, 1.045, 1.049, 1.05, 1.048, 1.044, 1.04, 1.035, 1.029, 1.024, 1.019, 1.015, 1.011, 1.007, 1.005, 1.003, 1)" },
    "$shadow-note": "Layered contact + ambient cast (soft cast, 2026-09-24). The :root value is the light ramp, tinted with the light ground ink; each theme re-declares its own in the top-level shadow block.",
    "shadow": { "sm": "0 1px 2px rgba(28,29,34,0.08), 0 0 0 1px rgba(28,29,34,0.03)", "md": "0 2px 4px rgba(28,29,34,0.06), 0 10px 28px rgba(28,29,34,0.12)", "lg": "0 4px 8px rgba(28,29,34,0.08), 0 28px 72px rgba(28,29,34,0.22)" },
    "focus": { "ring-width": "2px", "ring-offset": "0px" },
    "$viz-note": "Categorical data-viz ramp (--sl-viz-0..7): distinct hues for arbitrary series / one-per-item colouring (agent walls, event kinds). Print-ink hues (vermilion, ultramarine, olive, ochre, …). The value here is the no-theme default (the dark ramp) emitted on :root; each theme re-declares the ramp at the lightness that clears 3:1 on its own grounds — see the top-level `viz` block. Not brand accents; independent of --sl-accent-*.",
    "viz": ["#ef806f", "#65a7fa", "#9ab140", "#d79628", "#e17eb9", "#14bcbc", "#68eeba", "#b28fef"]
  },
  "themes": {
    "light": {
      "bg-canvas": "#F4F4F8", "bg-surface": "#FAFAFC", "bg-surface-raised": "#FFFFFF", "bg-overlay": "rgba(28,29,34,0.4)",
      "border-subtle": "rgba(28,29,34,0.09)", "border-default": "rgba(28,29,34,0.16)", "border-strong": "rgba(28,29,34,0.28)",
      "text-primary": "#1C1D22", "text-secondary": "#454857", "text-muted": "#5F6374", "text-on-accent": "oklch(from var(--sl-accent-default) clamp(0.22, (0.61 - l) * 1000, 1) 0 h)",
      "status-success": "#4a6205", "status-warning": "#795305", "status-danger": "#a72b05", "status-info": "#3853af"
    },
    "dark": {
      "bg-canvas": "#070A0D", "bg-surface": "#0F151A", "bg-surface-raised": "#131C23", "bg-overlay": "rgba(0,0,0,0.6)",
      "border-subtle": "rgba(218,227,228,0.07)", "border-default": "rgba(218,227,228,0.13)", "border-strong": "rgba(218,227,228,0.28)",
      "text-primary": "#DAE3E4", "text-secondary": "#9AA9AD", "text-muted": "#7C8D95", "text-on-accent": "#0A0A0B",
      "status-success": "#98b958", "status-warning": "#db9e2e", "status-danger": "#fe8263", "status-info": "#87a7fd"
    },
    "high-contrast": {
      "bg-canvas": "#000000", "bg-surface": "#000000", "bg-surface-raised": "#0a0a0a", "bg-overlay": "rgba(0,0,0,0.85)",
      "border-subtle": "#ffffff", "border-default": "#ffffff", "border-strong": "#ffff00",
      "text-primary": "#ffffff", "text-secondary": "#ffffff", "text-muted": "#cccccc", "text-on-accent": "#000000",
      "status-success": "#00ff00", "status-warning": "#ffaa00", "status-danger": "#ff5555", "status-info": "#00ffff"
    }
  },
  "accent": {
    "light": { "default": "#FF9F1C", "text-lmax": 0.5, "hover": { "mix": [89, "black"] }, "active": { "mix": [76, "black"] }, "subtle": { "mix": [12, "transparent"] }, "depth": "#14606C" },
    "dark": { "default": "#F5A83C", "band-text-lmax": 0.45, "hover": { "mix": [80, "white"] }, "active": { "oklch": ["calc(l * 0.92)", "calc(c * 0.96)", "h"], "fallback": "#E0942A" }, "subtle": { "mix": [16, "transparent"] }, "depth": "#35A0B4" },
    "high-contrast": { "default": "#ffff00", "band-text-lmax": 0.45, "hover": { "mix": [37, "white"] }, "active": { "mix": [80, "black"] }, "subtle": { "mix": [10, "black"] }, "depth": "#00ffff" }
  },
  "$code-note": "Syntax-highlight palette (--sl-code-<role>): code is viz, out of the single-brand-accent scope — a code token stays semantically stable and readable, it does not track the product hue. Print inks, the same family as status and viz; every role clears 4.5:1 (comment/null 3:1) on canvas, surface and raised. Emitted per theme; high-contrast intentionally omitted (undefined there, consumers fall back).",
  "code": {
    "light": { "fg": "#383a42", "comment": "#727e7f", "keyword": "#4460b6", "string": "#536d0b", "number": "#aa442b", "boolean": "#aa442b", "function": "#1f6a96", "tag": "#b33c1e", "builtin": "#865d06", "null": "#727e7f" },
    "dark": { "fg": "#DAE3E4", "comment": "#687475", "keyword": "#87a7fd", "string": "#99b860", "number": "#f5886c", "boolean": "#f5886c", "function": "#6db3e4", "tag": "#fe8263", "builtin": "#d4a14a", "null": "#687475" }
  },
  "$viz-theme-note": "Per-theme --sl-viz-0..7, emitted into each theme file after shared.viz on :root. High-contrast reuses the dark ramp (its ground is black).",
  "viz": {
    "light": ["#E0405E", "#2F6FE0", "#0E958A", "#D26A00", "#7A35E0", "#2E8540", "#A57C00", "#C93FC4"],
    "dark": ["#ef806f", "#65a7fa", "#9ab140", "#d79628", "#e17eb9", "#14bcbc", "#68eeba", "#b28fef"],
    "high-contrast": ["#ef806f", "#65a7fa", "#9ab140", "#d79628", "#e17eb9", "#14bcbc", "#68eeba", "#b28fef"]
  },
  "$spectrum-note": "Prism (light theme only). --sl-spectrum-0..5 is light (glow: aurora bloom, press, haze), never text, never the only carrier of a meaning. --sl-spectrum-ink-0..4 is the same wheel darkened to >= 3:1 on the light grounds, for anything seen at 1px or as text (rims, aurora --rim/--linear, glitch, halftone, spectral text). Other themes reset both to `initial` so consumers fall back to their accent-derived colour. Not an accent: it never tracks the product hue and never marks state.",
  "spectrum": {
    "light": {
      "light": ["#FF4D6D", "#FF9F1C", "#FFD60A", "#2EC4B6", "#3A86FF", "#8338EC"],
      "ink": ["#D6264A", "#B85A00", "#0B857A", "#2A62D8", "#7A2FE0"]
    }
  },
  "$shadow-theme-note": "Per-theme --sl-shadow-*: the cast takes the ground ink (teal-black on paper, black on the abyss, where it needs ~2.6x the alpha to read). High-contrast reuses dark.",
  "shadow": {
    "light": { "sm": "0 1px 2px rgba(28,29,34,0.08), 0 0 0 1px rgba(28,29,34,0.03)", "md": "0 2px 4px rgba(28,29,34,0.06), 0 10px 28px rgba(28,29,34,0.12)", "lg": "0 4px 8px rgba(28,29,34,0.08), 0 28px 72px rgba(28,29,34,0.22)" },
    "dark": { "sm": "0 1px 2px rgba(0,0,0,0.21), 0 0 0 1px rgba(0,0,0,0.08)", "md": "0 2px 4px rgba(0,0,0,0.16), 0 10px 28px rgba(0,0,0,0.31)", "lg": "0 4px 8px rgba(0,0,0,0.21), 0 28px 72px rgba(0,0,0,0.57)" },
    "high-contrast": { "sm": "0 1px 2px rgba(0,0,0,0.21), 0 0 0 1px rgba(0,0,0,0.08)", "md": "0 2px 4px rgba(0,0,0,0.16), 0 10px 28px rgba(0,0,0,0.31)", "lg": "0 4px 8px rgba(0,0,0,0.21), 0 28px 72px rgba(0,0,0,0.57)" }
  },
  "terminal": {
    "prompt": { "ansi": "bright_yellow", "true": "#F5A83C" },
    "ok":     { "ansi": "green",         "true": "#62D094" },
    "warn":   { "ansi": "yellow",        "true": "#F5A83C" },
    "err":    { "ansi": "red",           "true": "#f87171" },
    "dim":    { "ansi": "bright_black",  "true": "#6E8088" },
    "accent": { "ansi": "cyan",          "true": "#35A0B4" }
  }
}
